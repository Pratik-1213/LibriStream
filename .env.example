# --- Backend Configuration ---
# Your MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/libriStreamDB?retryWrites=true&w=majority

# The port your backend server runs on
PORT=5000

# --- Frontend Configuration ---
# The URL your React app uses to talk to the Backend
VITE_API_URL=http://localhost:5000/api

# Gemini API Key for AI book recommendations
GEMINI_API_KEY=your_gemini_api_key_here
